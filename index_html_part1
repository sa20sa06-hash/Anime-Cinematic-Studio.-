<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<meta name="theme-color" content="#070812">
<title>مواجهة مالك ومروان | ملف الإنتاج</title>
<style>
:root{--blue:#55baff;--purple:#cf79ff;--bg:#070812;--panel:#101322;--line:#39415c}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 18% 12%,#10233c 0,transparent 42%),radial-gradient(ellipse at 85% 18%,#32163d 0,transparent 40%),var(--bg);color:#f3f5ff;font-family:system-ui,Tahoma,Arial,sans-serif}
header{padding:18px 15px 12px;text-align:center;border-bottom:1px solid #ffffff20}h1{font-size:clamp(21px,5vw,34px);margin:0 0 6px}header p{margin:0;color:#aeb8d4;font-size:13px}
main{max-width:1000px;margin:auto;padding:14px;display:grid;gap:14px}
.card{background:linear-gradient(145deg,#151a2b,#0c0f1b);border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 14px 35px #0008}
.card h2{font-size:17px;margin:0;padding:13px 14px;border-bottom:1px solid #ffffff16}
.sheet{width:100%;display:block}
.note{padding:12px 14px;color:#c7d0e8;font-size:13px;line-height:1.8}
.controls{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:12px}
button{border:0;border-radius:13px;padding:13px 8px;color:white;font-weight:800;font-size:15px;cursor:pointer}
#startM{background:linear-gradient(135deg,#145a9b,#168dcb);box-shadow:0 5px 18px #168dcb55}
#startF{background:linear-gradient(135deg,#642b91,#b34ed1);box-shadow:0 5px 18px #b34ed155}
.tools{display:flex;gap:8px;padding:0 12px 12px}.tools button{flex:1;background:#242b40;border:1px solid #59617b;font-size:13px}
.status{padding:13px 14px;display:flex;justify-content:space-between;align-items:center;gap:10px}
#timer{font-size:25px;font-variant-numeric:tabular-nums;font-weight:900}
#state{color:#aeb8d4;font-size:12px}
.timeline{padding:0 14px 14px}.track{height:8px;background:#252b3e;border-radius:20px;overflow:hidden}.fill{height:100%;width:0;background:linear-gradient(90deg,var(--blue),var(--purple));transition:width .12s}
ol{margin:0;padding:0 22px 15px 14px;color:#dce2f5;line-height:1.9;font-size:13px}
.warn{border-color:#775c32}.warn h2{color:#ffd18a}.warn .note{color:#f1d9b2}
footer{text-align:center;color:#75809e;font-size:11px;padding:5px 15px 24px}
@media(min-width:760px){main{grid-template-columns:1.2fr .8fr;align-items:start}.reference{grid-row:span 3}}
</style>
</head>
